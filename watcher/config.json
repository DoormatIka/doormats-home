{
  "owner": "DoormatIka",
  "repo": "doormats-home",
  "commit_file": "/app/state/latest-commit",
  "interval": 60,
  "projects": [
    {
      "from": "/web",
      "to": "/deploy/web",
      "excluding": [
        "vite.config.js",
        "cli/",
        "package-lock.json",
        "package.json",
        "tsconfig.json",
        ".prettierrc.json",
        ".gitignore",
        ".gitattributes"
      ],
      "commands": [
        [
          "docker",
          "compose",
          "-f",
          "/deploy/docker-compose.yml",
          "exec",
          "-T",
          "web",
          "caddy",
          "reload",
          "--config",
          "/etc/caddy/Caddyfile"
        ]
      ]
    },
    {
      "from": "/server",
      "to": "/deploy/server",
      "excluding": [],
      "commands": [
        [
          "docker",
          "compose",
          "-f",
          "/deploy/docker-compose.yml",
          "up",
          "-d",
          "--build",
          "server"
        ]
      ]
    }
  ]
}
